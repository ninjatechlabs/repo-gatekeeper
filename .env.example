# Repo Gatekeeper Configuration
# Copy to .env and customize as needed.

# Local OpenAI-compatible LLM endpoint
# Ollama default:
LLM_BASE_URL=http://host.docker.internal:11434/v1
# OmniRoute alternative:
# LLM_BASE_URL=http://host.docker.internal:20128/v1

LLM_MODEL=qwen2.5-coder:7b
LLM_API_KEY=ollama

# Server & Storage
GATEKEEPER_PORT=8088
GATEKEEPER_SCAN_DIR=/tmp/gatekeeper_scans
GATEKEEPER_APPROVED_DIR=/app/approved_repos
